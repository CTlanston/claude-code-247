{
  "name": "aedev",
  "version": "2.4.0-patch1",
  "private": true,
  "description": "Local-first 24/7 AI engineering OS",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "NODE_ENV=test VITEST=1 AEDEV_COCKPIT_FORCE_TEMPLATE=1 AEDEV_COCKPIT_FORCE_MOCK=1 vitest run",
    "test:smoke": "sh -c 'AEDEV_GEMINI_API_KEY=\"${AEDEV_GEMINI_API_KEY:-$GEMINI_API_KEY}\" AEDEV_OPENAI_API_KEY=\"${AEDEV_OPENAI_API_KEY:-$OPENAI_API_KEY}\" AEDEV_SMOKE_CLAUDE=1 AEDEV_SMOKE_DOCKER=1 AEDEV_SMOKE_GEMINI=1 AEDEV_SMOKE_OPENAI=1 vitest run packages/runner/src/claude-adapter.test.ts packages/runner/src/docker-runner.test.ts packages/validators/src/gemini-validator.test.ts packages/validators/src/openai-validator.test.ts --testTimeout 180000'",
    "test:smoke:legacy-claude247": "AEDEV_SMOKE_CLAUDE247=1 vitest run packages/claude247-bridge/src/bridge.test.ts --testTimeout 180000",
    "cockpit:dev": "tsx scripts/dev-operator-cockpit.ts --replace",
    "test:cockpit:e2e": "tsx scripts/operator-cockpit-e2e.ts",
    "test:cockpit:quality-smoke": "tsx scripts/operator-cockpit-webui-quality-smoke.ts",
    "test:cockpit:user-e2e": "tsx scripts/operator-cockpit-user-e2e.ts",
    "test:cockpit:screens": "tsx scripts/operator-cockpit-screens.ts",
    "test:cockpit:real-smoke": "tsx scripts/operator-cockpit-real-smoke.ts",
    "test:cockpit:p3-remote-smoke": "tsx scripts/operator-cockpit-p3-remote-smoke.ts",
    "test:v24:s0": "tsx scripts/v24-vertical-slice-s0.ts",
    "demo:hermus-obsidian": "tsx scripts/demo-hermus-obsidian-system.ts",
    "test:e2e:sandbox": "tsx scripts/e2e-sandbox.ts",
    "test:hermus:mission": "tsx scripts/hermus-mission-smoke.ts",
    "test:fleet:soak": "tsx scripts/fleet-soak.ts",
    "test:mission-os:dry-soak": "node --import tsx scripts/mission-os-dry-soak.ts",
    "test:workbook": "tsx scripts/workbook-acceptance.ts",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aedev/core": "workspace:*",
    "@aedev/daemon": "workspace:*",
    "@aedev/qa": "workspace:*",
    "@aedev/runner": "workspace:*",
    "@aedev/validators": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "playwright": "^1.60.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
