# Python
__pycache__/
*.pyc
.venv/

# Secrets — .env.example stays tracked
.env

# Orchestrator state (operational data, not source)
state/*.db
state/*.db-*
state/*.bak.*
state/PAUSED
state/PAUSED.human
state/metrics.json
workspaces/

# macOS
.DS_Store

# AutoDev v3 operational files (regenerated each cycle)
reports/heartbeat.json
reports/notify.log
reports/supervisor.stdout.log
reports/supervisor.stderr.log
reports/supervisor.log
reports/state.corrupt.*.json
reports/com.autodev.supervisor.plist
state/.autodev_supervisor.lock
tasks/current.md

# Claude Code session lock files
.claude/scheduled_tasks.lock

# Hypothesis property-testing database (cache + statistics)
.hypothesis/

# L7 transient + scratch (the cycles/ folder is committed; scratch inside it is not)
cycles/*/scratch/

# NOTE: BLOCKED.md and ALERT.md are escalation signals — they are tracked
# when they exist (so a passing human reviewer can see them), and a cycle
# is allowed to commit them. They are deleted (not ignored) when resolved.


# Git worktrees (Track C2-init); the worktree DIR is excluded but the
# worktree relationship is recorded by git itself in .git/worktrees/
worktrees/

# Codex per-PR runtime log — grows unbounded; reports/codex-spend.jsonl
# (calibration + cycle-level entries) IS committed, but codex-reviews.jsonl
# (one row per actual PR review) stays operational-only.
reports/codex-reviews.jsonl
