.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Claude Code session lock files
.claude/scheduled_tasks.lock
.claude/launch.json

# Runtime state lives outside the repo (~/.claude-code-247/) but if a
# developer points it inside the repo, ignore the common dirs.
state/
workspaces/
worktrees/
logs/
.evidence/

# High-frequency launch evidence is summarized in rollup files; raw tick
# payloads stay local/runtime-only unless a stage explicitly promotes one.
evidence/launch/roadmap-agent-tick-*.json
evidence/launch/roadmap-agent-tick-*.md

# Superseded local launchd self-dev prototype. Codex app automations are the
# canonical autonomous continuation plane for this phase.
scripts/self-dev-runbook.md
scripts/self-dev-tick.sh
scripts/launchd/com.claude247.self-dev.plist.tpl

# Operator backups & sentinels created in archive/auto-evo/state/ at runtime
archive/auto-evo/state/*.db
archive/auto-evo/state/*.db-*
archive/auto-evo/state/PAUSED
archive/auto-evo/state/PAUSED.human
archive/auto-evo/state/metrics.json
archive/auto-evo/reports/runs/
archive/auto-evo/reports/heartbeat.json
archive/auto-evo/reports/notify.log
archive/auto-evo/reports/supervisor.*
archive/auto-evo/reports/health.json
archive/auto-evo/reports/health.md
archive/auto-evo/reports/health.history.jsonl
archive/auto-evo/reports/adversarial-reviews.jsonl
archive/auto-evo/reports/codex-reviews.jsonl
archive/auto-evo/workspaces/
archive/auto-evo/cycles/*/scratch/
archive/auto-evo/tasks/current.md
