# ===== Anthropic =====
ANTHROPIC_API_KEY=sk-ant-xxx

# ===== Models =====
PLANNER_MODEL=claude-sonnet-4-6
CODER_MODEL=claude-sonnet-4-6
REVIEWER_MODEL=claude-opus-4-7
GUARDIAN_MODEL=claude-opus-4-7

# ===== GitHub =====
# 推荐 GitHub App，简化为 PAT 也行。需要 Issues/PR/Contents/Actions 读写权限
GITHUB_TOKEN=ghp_xxx
GITHUB_REPO=your-org/auto-evo-playground
GITHUB_DEFAULT_BRANCH=main
GITHUB_SHADOW_PREFIX=shadow

# ===== Orchestrator =====
ORCHESTRATOR_POLL_INTERVAL_SECONDS=30
DAILY_TOKEN_BUDGET_USD=30
PER_ISSUE_TOKEN_LIMIT=200000
PER_ISSUE_MAX_REVIEW_ROUNDS=3

# ===== Circuit Breaker =====
CI_FAILURE_THRESHOLD_PER_HOUR=5
GUARDIAN_INTERVAL_MINUTES=30

# ===== Allowlists（容器出口代理用）=====
NETWORK_ALLOWLIST=api.anthropic.com,github.com,api.github.com,pypi.org,files.pythonhosted.org,registry.npmjs.org

# ===== 通知 =====
SLACK_WEBHOOK_URL=

# ===== WORKBOOK_v4 P1 · Agent SDK credit guard =====
# Caps on metered headless `claude --print` calls (events: cost.headless_call).
AEDEV_BUDGET_MAX_HEADLESS_PER_MISSION=15
AEDEV_BUDGET_MAX_HEADLESS_PER_DAY=60
# P2 cross-engine review: max repair rounds before HOLD-REVIEW-LOOP
AEDEV_BUDGET_MAX_REVIEW_CYCLES=2
# ntfy push for HOLD-BUDGET (optional; AEDEV_NTFY_URL defaults to https://ntfy.sh)
AEDEV_NTFY_TOPIC=

# ===== WORKBOOK_v4 P3 · 24/7 watchdog =====
# Tick cadence (minutes); each tick is zero LLM calls.
AEDEV_WATCHDOG_TICK_MINUTES=30
# Nightly Memory Compiler runs at/after this local hour, once per day.
AEDEV_WATCHDOG_COMPILE_HOUR=2
# A running mission with no events for this many minutes is flagged stale.
AEDEV_WATCHDOG_STALE_MINUTES=45
